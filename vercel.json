{
  "version": 2,
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron?mode=today&slot=morning",
      "schedule": "0 22 * * *"
    },
    {
      "path": "/api/cron?mode=today&slot=evening",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/timeline?mode=auto",
      "schedule": "5 22 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors *;"
        },
        {
          "key": "Cache-Control",
          "value": "s-maxage=0, no-store, no-cache, must-revalidate"
        }
      ]
    }
  ]
}